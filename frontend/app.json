{
  "expo": {
    "name": "DatSanTheThao",
    "slug": "DatSanTheThao",
    "scheme": "datsan",
    "experiments": {
      "typedRoutes": false
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2E",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-camera",
      "expo-location",
      "expo-image-picker",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
