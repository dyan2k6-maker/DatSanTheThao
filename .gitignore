# ==========================================
# 1. LARAVEL BACKEND (/backend)
# ==========================================
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.local
backend/.env.*.local
!backend/.env.example
backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php

# ==========================================
# 2. REACT NATIVE / EXPO FRONTEND (/frontend)
# ==========================================
frontend/node_modules/
frontend/.expo
frontend/.expo/
frontend/.expo/*
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts

# ==========================================
# 3. COMMON / NATIVE / OS FILES
# ==========================================
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
composer-setup.php

# macOS / Windows OS files
.DS_Store
Thumbs.db
*.pem

# TypeScript build info
*.tsbuildinfo